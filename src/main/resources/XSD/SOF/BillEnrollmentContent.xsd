 			<element name="BillInfo" type="tns:BillInfoType"
 				maxOccurs="1" minOccurs="0">
 			</element>
 			<element name="HasMandate" type="boolean" maxOccurs="1" minOccurs="0"></element>
 		</sequence>
 	</complexType>

 	<complexType name="EnrsMandsRecsType">
 		<sequence>
 			<element name="EnrMandsRec" type="tns:EnrMandsRecType" minOccurs="1" maxOccurs="unbounded"></element>
 		</sequence>
