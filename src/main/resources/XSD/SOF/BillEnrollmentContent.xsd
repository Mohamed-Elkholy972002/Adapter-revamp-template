<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.fawry-eg.com/ebpp/IFXMessages/" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.fawry-eg.com/ebpp/IFXMessages/">
	<include schemaLocation="CoreLib.xsd"></include>
	
	<complexType name="BillEnrRqType">
		<sequence>
			<element name="CustIds" type="tns:CustIdsType" minOccurs="0" maxOccurs="1" />
			<element name="RecCtrlIn" type="tns:RecCtrlInType" minOccurs="0" maxOccurs="1" />
			<element name="FawryCustNumber" minOccurs="0" maxOccurs="1" type="tns:FawryCustNumberType" />
			<element name="EnrDataRecs" type="tns:EnrDataRecsType" maxOccurs="1" minOccurs="1"></element>
		</sequence>
	</complexType>
 	
 	<complexType name="EnrDataRqType">
 		<sequence>
 			<element name="OptType" minOccurs="1" maxOccurs="1" type="tns:OptTypeEnum"/>
 			<element name="EnrType" minOccurs="0" maxOccurs="1" type="tns:EnrTypeOpenEnum"/>
 			<element name="BillerId" minOccurs="0" maxOccurs="1" type="tns:Identifier_Type"/>
 			<element name="BillTypeCode" type="long" minOccurs="1" maxOccurs="1"/>
 			<element name="PmtType" type="tns:PmtTypeOpenEnum" minOccurs="0" maxOccurs="1"/>
 			<element name="BillingAcct" minOccurs="1" maxOccurs="1">
				<simpleType>
					<restriction base="string">

						<maxLength value="128"></maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="ExtraBillingAcctKeys" type="tns:ExtraBillingAcctKeysType" minOccurs="0" maxOccurs="1">
			</element>		
			<element name="StrDate" type="date" minOccurs="0" maxOccurs="1"/>
			<element name="Alias" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">

						<maxLength value="32"></maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="BillingCycleCode" minOccurs="0" maxOccurs="1" type="tns:BillingCycleCodeType"/>
            <element name="EnrStatus" minOccurs="0" maxOccurs="1" type="tns:EnrStatusEnum" />
            <element name="DeactivationReason" minOccurs="0" maxOccurs="1">
 				<simpleType>
 					<restriction base="string">
 						<maxLength value="256"/>
 					</restriction>
 				</simpleType>
 			</element>
            <element name="EnrUID" minOccurs="0" maxOccurs="1" type="tns:Identifier_Type" />
            
            <element name="NotifyMobile" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">

						<maxLength value="32"></maxLength>
					</restriction>
				</simpleType>
			</element>
        </sequence>
 	</complexType>

 	
 	<complexType name="BillEnrRsType">
