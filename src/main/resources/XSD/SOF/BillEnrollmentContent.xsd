 				</simpleType>
 			</element>

 			<element name="NotifyMobile" minOccurs="0" maxOccurs="1">
 				<simpleType>
 					<restriction base="string">

 						<maxLength value="32"></maxLength>
 					</restriction>
 				</simpleType>
 			</element>

 			<element name="EnrStatus" minOccurs="0" maxOccurs="1"
 				type="tns:EnrStatusEnum" />
 			<element name="HasMandate" type="boolean" maxOccurs="1" minOccurs="0"></element>
 		</sequence>
  	</complexType>
 	
 	<complexType name="GetEnrRqType">
		<sequence>
			<element name="RecCtrlIn" type="tns:RecCtrlInType" minOccurs="0" maxOccurs="1"/>
			<element name="SearchData" minOccurs="1" maxOccurs="1" type="tns:SearchDataType"/>
		</sequence>
	</complexType>
	
	<complexType name="SearchDataType">
		<sequence>
			<element name="CustIds" type="tns:CustIdsType" minOccurs="0"
				maxOccurs="1" />

			<element name="EnrUID" type="tns:Identifier_Type" minOccurs="0" maxOccurs="1">
