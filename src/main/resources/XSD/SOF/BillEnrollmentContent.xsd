			<element name="BillTypeCode" type="tns:Identifier_Type" maxOccurs="1" minOccurs="0"></element>
			<element name="EnrollmentType" type="tns:EnrollmentTypeOpenEnum" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
 	
	<complexType name="GetEnrRsType">
