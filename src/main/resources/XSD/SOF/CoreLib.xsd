			<element name="CustData" minOccurs="0" maxOccurs="1"
				type="tns:CustDataType" />

			<element name="Attachments" type="tns:AttachmentsType"
				minOccurs="0" maxOccurs="1">
			</element>
		</sequence>
	</complexType>
