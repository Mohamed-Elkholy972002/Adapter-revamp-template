	<complexType name="SvcCommonType">
		<sequence>
			<element name="RqUID" minOccurs="1">
				<simpleType>
					<restriction base="tns:Identifier_Type">
						<pattern
							value="([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})|[a-zA-Z0-9]{12}|[a-zA-Z0-9]{16}">
						</pattern>
					</restriction>
				</simpleType>
			</element>
			<element name="AsyncRqUID" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="tns:Identifier_Type">
						<pattern
							value="([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})|[a-zA-Z0-9]{12}|[a-zA-Z0-9]{16}">
						</pattern>
					</restriction>
				</simpleType>
			</element>
			<element name="MsgRqHdr" type="tns:MsgRqHdrType"
				minOccurs="0">
