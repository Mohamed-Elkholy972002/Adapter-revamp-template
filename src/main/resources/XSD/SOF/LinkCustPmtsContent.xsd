	<include schemaLocation="CoreLib.xsd"></include>



	<complexType name="LinkCustPmtsRqType">
		<sequence>
			<element name="CustPmtsInfo" type="tns:CustPmtsInfoType" maxOccurs="1" minOccurs="1"></element>
		</sequence>
	</complexType>

	<complexType name="LinkCustPmtsRsType">
		<sequence>
			<element name="CustPmtsInfo" type="tns:CustPmtsInfoType" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>


	<complexType name="CustPmtsInfoType">
		<sequence>
			<element name="CustIds" type="tns:CustIdsType" minOccurs="1"
				maxOccurs="1" />
				
			<element name="PmtTransId" type="tns:PmtTransIdType"
				minOccurs="1" maxOccurs="unbounded">
			</element>
		</sequence>
	</complexType>

	



</schema>